# AWS credentials used server-side by NexoMaker Studio
AWS_ACCESS_KEY_ID=replace_with_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_secret_access_key
AWS_REGION=eu-west-3

# Claude Haiku via Amazon Bedrock
BEDROCK_TEXT_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional image generation configuration
BEDROCK_IMAGE_REGION=us-west-2
BEDROCK_IMAGE_MODEL_ID=stability.stable-image-core-v1:1
